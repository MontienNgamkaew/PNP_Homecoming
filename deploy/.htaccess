Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^\.well-known/acme-challenge/ - [L]
# Credentials, SQL, source maps, and runtime files must never be public.
RewriteRule (^|/)(\.|config\.|composer\.|package\.) - [F,L]
RewriteRule \.(sql|sqlite3?|log|bak|env|map)$ - [F,L,NC]
RewriteRule ^api(?:/.*)?$ api.php [END,QSA]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "no-referrer"
Header always set X-Frame-Options "DENY"
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
